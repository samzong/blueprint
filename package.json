{
  "name": "@samzong/blueprint",
  "version": "0.1.4",
  "description": "Deterministic web scaffolding, preview, and deployment for the blueprint agent skill.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samzong/blueprint.git"
  },
  "type": "module",
  "bin": {
    "blueprint": "./dist/bin.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "blueprint": "node src/bin.ts",
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm build && node --test test/*.test.ts",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/select": "^5.2.1",
    "@kitup/sdk": "^0.1.3",
    "parse5": "^8.0.1",
    "reveal.js": "6.0.1"
  }
}
